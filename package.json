{
  "name": "closeclaw",
  "version": "0.1.0",
  "description": "AI-powered macOS universal desktop assistant with live auto-update",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext .ts,.tsx --ignore-pattern dist --ignore-pattern dist-electron",
    "typecheck": "tsc --noEmit",
    "package": "electron-builder --config electron-builder.yml",
    "release": "npm run build && npm run package"
  },
  "dependencies": {
    "electron-updater": "^6.1.7",
    "node-llama-cpp": "^3.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
